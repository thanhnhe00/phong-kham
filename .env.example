# Sao chép thành .env. KHÔNG commit file .env.
POSTGRES_USER=phongkham
POSTGRES_PASSWORD=phongkham
POSTGRES_DB=phongkham

# Khóa ký token đăng nhập, chuỗi ngẫu nhiên tối thiểu 32 ký tự
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Xác minh số điện thoại khi đăng ký / quên mật khẩu: người dùng NHẮN "PKXM <mã>" từ chính SIM của họ tới số của
# phòng khám. Một điện thoại làm cổng SMS chuyển tin về /api/sms/inbound (xem README "Xác minh số điện thoại").
# Số SIM của máy cổng (bệnh nhân nhắn tới số này)
SMS_VERIFY_NUMBER=
# iPhone Phím tắt / cổng khác: chuỗi bí mật dài, gửi trong header X-Gateway-Token
SMS_GATEWAY_TOKEN=
# Android "SMS Gateway": Settings -> Webhooks -> Signing Key
SMS_GATEWAY_SIGNING_KEY=

# Chống spam theo IP. Chỉ đặt false trên máy chạy kiểm thử tự động / đo hiệu năng (mọi yêu cầu cùng một IP)
RATE_LIMIT_ENABLED=true

# Giám sát: token để Prometheus đọc số liệu backend (chuỗi ngẫu nhiên dài); mật khẩu admin Grafana
METRICS_TOKEN=doi-thanh-chuoi-ngau-nhien-dai
GRAFANA_ADMIN_PASSWORD=doi-mat-khau-nay

# Cổng trên máy (đổi nếu trùng dự án khác): web nhân viên, Grafana, Prometheus
WEB_PORT=8088
GRAFANA_PORT=3005
PROMETHEUS_PORT=9095

# true = tạo dữ liệu demo khi DB chưa có tài khoản (mật khẩu demo 12345678, admin 0900000001)
SEED_DEMO=true
